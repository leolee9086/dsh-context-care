{
  "name": "dsh-context-care",
  "version": "0.13.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "为 DeepSeek Harness 提供疲劳度、唤醒值、分段彩色数值显示与自主上下文压缩的独立 Cordis 插件",
  "repository": {
    "type": "git",
    "url": "https://github.com/leolee9086/dsh-context-care.git"
  },
  "homepage": "https://github.com/leolee9086/dsh-context-care#readme",
  "bugs": {
    "url": "https://github.com/leolee9086/dsh-context-care/issues"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "context-management",
    "context-compaction",
    "llm",
    "agent"
  ],
  "exports": {
    ".": "./src/display-host.js",
    "./runtime": "./src/host.js",
    "./agent": "./src/index.js",
    "./completion": "./src/completion-host.js",
    "./requests": "./src/request-host.js",
    "./reminders": {
      "types": "./lib/reminder-runtime/runtime.d.ts",
      "default": "./lib/reminder-runtime/runtime.js"
    },
    "./activate": "./src/activate.js",
    "./declarations": "./src/declarations.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-layout"
      ]
    }
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "agent.example.cordis.yml"
  ],
  "scripts": {
    "build": "pnpm build:host && tsdown",
    "build:host": "tsc -p tsconfig.reminders.json",
    "preview:build": "node test/build-preview.js",
    "test": "pnpm build:host && node test/run-unit.js",
    "test:integration": "pnpm build:host && node --test test/integration.test.js",
    "test:integration:source": "pnpm build:host && node test/run-source-integration.js",
    "test:client:source": "node test/run-client-source.js",
    "check": "tsc -p tsconfig.reminders.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.host.json && tsc -p tsconfig.tests.json && node test/check-source.js",
    "sync:events": "node scripts/sync-session-events.ts",
    "sync:events:check": "node scripts/sync-session-events.ts --check",
    "release:check": "pnpm check && pnpm sync:events:check && pnpm test && pnpm build",
    "release:pack": "pnpm release:check && pnpm pack --pack-destination artifacts"
  },
  "dependencies": {
    "@leolee9086/dsh-rule-engine": "0.3.0",
    "@leolee9086/dsh-session-blocks": "0.1.0",
    "ajv": "^8.20.0",
    "handlebars": "^4.7.10",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^18.3.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.20.5",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "5.8.3"
  }
}
