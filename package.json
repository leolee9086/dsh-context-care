{
  "name": "dsh-context-care",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "为 DeepSeek Harness 提供疲劳度、唤醒值、分段彩色数值显示与自主上下文压缩的独立 Cordis 插件",
  "repository": { "type": "git", "url": "https://github.com/leolee9086/dsh-context-care.git" },
  "homepage": "https://github.com/leolee9086/dsh-context-care#readme",
  "bugs": { "url": "https://github.com/leolee9086/dsh-context-care/issues" },
  "keywords": ["deepseek-harness", "cordis", "context-management", "context-compaction", "llm", "agent"],
  "exports": { ".": "./src/host.js", "./agent": "./src/index.js", "./activate": "./src/activate.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": { "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"] } },
  "files": ["src", "lib", "cordis.patch.yml", "README.md", "DESIGN.md", "CHANGELOG.md", "agent.example.cordis.yml"],
  "scripts": { "build": "tsdown", "test": "node --test test/activate.test.js test/client.test.js test/context-care.test.js test/dependencies.test.js test/general.test.js", "test:integration": "node --test test/integration.test.js", "check": "node --check src/index.js && node --check src/host.js" },
  "dependencies": { "zod": "^4.4.3", "react": "^18.3.1" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2"
  }
}
