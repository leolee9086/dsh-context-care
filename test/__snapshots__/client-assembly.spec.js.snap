// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`records open in the real right sidebar, remain session scoped, and leave runtime independent on display unload > composer entry and right sidebar records 1`] = `
<div>
  <div
    data-slot="root"
    style="display: contents;"
  >
    <div
      data-surface="composer"
    >
      <div
        data-slot="conversation.composer.dock"
        style="display: contents;"
      >
        <div
          data-context-care=""
          role="status"
          style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; font-size: 12px; color: var(--dsw-alias-label-secondary); padding: 2px 4px;"
          title="最近一次请求准备时的负荷与保留信息量估算；不是记忆可靠性判断，也不是任务时限。"
        >
          <span
            style="color: rgb(59, 130, 246); font-weight: 600;"
          >
            疲劳度: 40% (正常)
          </span>
          <span
            style="color: rgb(20, 184, 166); font-weight: 600;"
          >
            唤醒值: 60% (较高)
          </span>
        </div>
        <div
          style="font-size: 12px;"
        >
          <button
            title="在右侧栏打开预算与维护记录"
            type="button"
          >
            预算与维护记录
          </button>
        </div>
      </div>
    </div>
    <aside
      data-surface="right-sidebar"
    >
      <div
        data-slot="sidebar.right.pane.tab"
        style="display: contents;"
      >
        <section
          data-context-care-actions=""
          style="height: 100%; box-sizing: border-box; overflow: auto; padding: 12px; font-size: 12px; color: var(--dsw-alias-label-secondary);"
        >
          <h3
            style="margin: 0px 0px 8px; font-size: 14px;"
          >
            预算与维护记录
          </h3>
          <div
            style="padding: 6px 0px; overflow-wrap: anywhere;"
          >
            <div>
              尚无请求预算记录
            </div>
            <details
              style="border-top: 1px solid var(--dsw-alias-border-primary); padding: 5px 0px;"
            >
              <summary>
                摘要 · 已提交
              </summary>
              <div>
                动作编号: session-one-0
              </div>
              <div>
                选区来源序号: —
              </div>
              <div>
                维护前后输入估算: 30,000 → 2,000
