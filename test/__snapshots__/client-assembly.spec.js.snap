              <div>
                记录状态: 动作记录已持久化
              </div>
            </details>
          </div>
          <div
            style="display: flex; gap: 8px; padding: 4px 0px;"
          >
            <button
              disabled=""
              type="button"
            >
              较新记录
            </button>
            <button
              type="button"
            >
              更早记录
            </button>
          </div>
        </section>
      </div>
    </aside>
  </div>
</div>
`;
